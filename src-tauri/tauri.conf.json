{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaikNote",
  "version": "0.10.22",
  "identifier": "com.april.maiknote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MaikNote",
        "width": 600,
        "height": 400,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#00000000",
        "visibleOnAllWorkspaces": false,
        "dragDropEnabled": false
      },
      {
        "label": "edge",
        "title": "MaikNote Edge",
        "url": "index.html",
        "width": 320,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "backgroundColor": "#00000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$APPDATA/**",
          "$LOCALDATA/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../.agents/skills/maiknote-guide": "skills/maiknote-guide",
      "icons/logos/*.icns": "logos/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./entitlements.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBOEY3NzZFMzY0NDU5RTMKUldUaldVUTJibmVQcWpPQjhwOXZ1aHZHT2RhNVZKcWFINTlTTjJjeUFRU1pWZmxEb3EwTWFCK1QK",
      "endpoints": [
        "https://github.com/1578393930/MaikNote-for-Windows/releases/latest/download/latest.json"
      ]
    }
  }
}
